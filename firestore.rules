rules_version = '2';

// À copier-coller dans Firebase Console > Firestore Database > Règles > Publier
//
// Le contenu du site est lisible par tous, modifiable seulement par les comptes
// listés dans la collection `admins`. Être connecté ne suffit pas : depuis que
// des invitations existent, n'importe qui peut se créer un compte Firebase, et
// un simple `request.auth != null` lui aurait ouvert l'écriture.
//
// Être membre ne suffit pas non plus : presque tout exige en plus d'avoir
// franchi la double authentification, attestée par un attribut posé sur le
// compte par le Worker. Sans cette exigence ici, elle ne vivait que dans le
// navigateur et le mot de passe seul ouvrait les données.
//
// Quatre rôles :
//   superadmin — tout, et seul à pouvoir nommer ou retirer un superadmin
//   admin      — le site, les commandes et les accès de l'équipe
//   editor     — le contenu du site uniquement : ni commandes, ni accès
//   comptoir   — le mode jour J uniquement : lit les commandes, avance
//                leur statut, rien d'autre

service cloud.firestore {
  match /databases/{database}/documents {

    function memberDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    // Accès au panel, quel que soit le rôle.
    function isMember() {
      return request.auth != null
          && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    /* La double authentification, exigée ici et plus seulement par le panel.
       Elle était entièrement dans le navigateur : le Worker tirait le code,
       le vérifiait et posait l'attribut, mais aucune règle ne le lisait. Le
       mot de passe seul suffisait donc à tout — une session ouverte par
       l'API publique de Firebase lisait les commandes en direct, sans que
       l'écran de code soit jamais affiché. La 2FA gardait la porte pendant
       que les fenêtres étaient ouvertes.

       Deux conditions, pas une. `a2fUntil` vaut pour le compte entier, sur
       n'importe quel poste : sans la seconde, se connecter ailleurs dans les
       8 heures héritait du « validé » sans jamais recevoir de code.
       `auth_time` ne bouge pas quand un jeton se rafraîchit, mais change à
       chaque vraie connexion — les comparer dit que CE poste a bien saisi
       le code.

       Les défauts de `get()` sont indispensables : un attribut absent fait
       échouer la règle entière, ce qui refuserait aussi ce qui est légitime. */
    function a2fFranchie() {
      return request.auth.token.get('a2fUntil', 0) > request.time.toMillis()
          && request.auth.token.get('a2fAuthTime', 0) == request.auth.token.get('auth_time', -1);
    }

    /* Membre du panel ET passé par le code. C'est cette fonction, et non
       `isMember()`, qui ouvre quoi que ce soit — à une exception près, plus
       bas : la lecture de sa propre entrée `admins`, qui doit rester
       possible avant la double authentification puisque c'est elle qui
       apprend au panel qui il a en face. */
    function membreVerifie() {
      return isMember() && a2fFranchie();
    }

    // Le défaut à 'admin' couvre le tout premier compte, créé à la main dans
    // la console avant que les rôles n'existent : sans lui, il perdrait la
    // main sur les accès.
    function myRole() {
      return memberDoc().get('role', 'admin');
    }

    // Gère les accès, les commandes et le catalogue de Noël.
    function isOwner() {
      return membreVerifie() && myRole() in ['superadmin', 'admin'];
    }

    // Au-dessus : seul un superadmin touche à un autre superadmin. C'est ce
    // qui laisse un recours si un administrateur fait n'importe quoi avec les
    // accès — il ne peut pas retirer celui qui pourrait le corriger.
    function isSuper() {
      return membreVerifie() && myRole() == 'superadmin';
    }

    // Comptoir : le mode jour J, rien d'autre. Ni le contenu du site, ni le
    // catalogue, ni les accès de l'équipe — seulement chercher une commande
    // et faire avancer son statut au comptoir.
    function isComptoir() {
      return membreVerifie() && myRole() == 'comptoir';
    }

    // La seule ecriture qu'un comptoir obtient sur une commande.
    function majStatutParComptoir() {
      return isComptoir()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['statut']);
    }


    // Les verrous sur les roles sont sortis en fonctions nommees : les
    // autorisations n'enchainent plus que des && a plat, et chaque condition
    // porte son intention dans son nom.

    // On ne retrograde pas un superadmin sans l'etre : sinon un admin retire
    // les acces du compte qui pourrait le corriger.
    function cibleModifiable() {
      return resource.data.get('role', 'admin') != 'superadmin' || isSuper();
    }

    // Et on n'en nomme pas un sans l'etre non plus, sinon un admin s'y
    // promeut lui-meme.
    function roleViseAutorise() {
      return request.resource.data.get('role', 'admin') != 'superadmin' || isSuper();
    }

    // Meme verrou pour les invitations, ou le role par defaut est 'editor' :
    // sans lui, un admin se fabrique une invitation superadmin, l'accepte
    // avec une seconde adresse, et les deux verrous du dessus ne valent plus
    // rien.
    function inviteNonSuperadmin() {
      return request.resource.data.get('role', 'editor') != 'superadmin' || isSuper();
    }

    // Le role vise doit faire partie des quatre existants : sans ce controle,
    // un admin ecrit n'importe quelle chaine et sort l'entree des cas prevus.
    function roleConnu() {
      return request.resource.data.get('role', 'admin') in ['superadmin', 'admin', 'editor', 'comptoir'];
    }

    // Un gestionnaire d'acces change les roles et les alertes. Rien d'autre
    // n'est modifiable : reecrire l'e-mail d'une entree permettrait de se
    // l'approprier.
    function majParGestionnaire() {
      return isOwner()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'notifications'])
          && roleConnu()
          && cibleModifiable()
          && roleViseAutorise();
    }

    // Chacun coupe ses propres alertes, sans toucher a son role.
    function majDeSesAlertes(uid) {
      return membreVerifie()
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notifications']);
    }

    // Contenu du site : le métier de base du panel, ouvert à tous les rôles
    // sauf le comptoir (voir juste en dessous). Exception plus bas pour
    // `settings/noel`.
    match /settings/{docId} {
      allow read:  if true;
      // Le comptoir est membre du panel pour lire sa propre entrée `admins`
      // et passer le contrôle d'accès, mais ce n'est pas un droit sur le
      // contenu du site : il ne doit pouvoir écrire nulle part ici.
      allow write: if membreVerifie() && myRole() != 'comptoir' && docId != 'noel';
    }

    // Ouverture des commandes, dates de retrait, délai d'annulation : cela
    // engage la boutique, pas seulement l'apparence du site.
    match /settings/noel {
      allow read:  if true;
      allow write: if isOwner();
    }

    match /blocks/{blockId} {
      allow read:  if true;
      allow write: if membreVerifie() && myRole() != 'comptoir';
    }

    // Catalogue des commandes de Noël (bûches, coffrets). Le site public le
    // lit pour afficher les produits ; il porte des prix, donc il suit les
    // commandes et non le contenu.
    match /noel_produits/{produitId} {
      allow read:  if true;
      allow write: if isOwner();
    }

    // Commandes des clients. Rien n'est ouvert au public, pas même la
    // création : le formulaire passe par le Worker, qui vérifie le jeton
    // Turnstile avant d'écrire avec la clé de service — laquelle contourne
    // ces règles. Une création directe depuis le navigateur permettrait de
    // remplir la boîte de commandes en ignorant la vérification anti-bot.
    // En lecture, elles portent nom, téléphone et e-mail de clients : le
    // rôle « réglages du site » n'y a pas accès.
    //
    // Le comptoir lit comme un admin — il doit pouvoir chercher n'importe
    // quelle commande — mais n'écrit que son statut. Il ne crée rien,
    // n'efface rien, ne touche ni au commentaire ni aux coordonnées : la
    // seule chose qu'on fait à ce poste, c'est avancer une commande dans
    // son parcours (confirmer, marquer prête, marquer récupérée).
    match /orders/{orderId} {
      allow read: if isOwner() || isComptoir();
      allow create, delete: if isOwner();
      allow update: if isOwner() || majStatutParComptoir();
    }

    // Compteur des codes de commande (SITE0001, SITE0002...). Le Worker
    // l'incrémente avec la clé de service, qui contourne ces règles ; ici on
    // ne traite que le panel.
    //
    // La remise à zéro est réservée au superadmin, et volontairement plus
    // fermée que les commandes elles-mêmes : rejouer le compteur fait
    // réapparaître des codes déjà donnés à des clients, et deux commandes
    // portant le même code ne se distinguent plus au comptoir. Un admin peut
    // le lire pour savoir où il en est, pas le réécrire.
    match /compteurs/{compteurId} {
      allow read:  if isOwner();
      allow write: if isSuper()
                   && request.resource.data.keys().hasOnly(['dernier'])
                   && request.resource.data.dernier is int
                   && request.resource.data.dernier >= 0;
    }

    // Personnes ayant accès au panel.
    match /admins/{uid} {
      /* Chacun lit sa propre entrée — c'est ainsi que le panel connaît son
         rôle. La liste complète, elle, porte les adresses de toute l'équipe
         et reste réservée à ceux qui gèrent les accès.

         Seule autorisation qui n'exige pas la double authentification, et
         il le faut : le panel lit cette entrée AVANT d'afficher l'écran du
         code, pour savoir s'il a affaire à un membre. L'exiger ici
         refuserait la lecture, le panel conclurait « pas d'accès » et
         personne n'entrerait plus. Ce qu'elle expose se limite au rôle et à
         l'adresse de qui la demande — rien qu'il ne sache déjà. */
      allow get:  if isMember();
      allow list: if isOwner();

      // Plus aucune création depuis un navigateur. C'est le Worker qui écrit
      // cette entrée, avec la cle de service, laquelle contourne ces règles.
      // Auparavant l'invité s'ajoutait lui-même, ce qui obligeait à laisser
      // l'inscription ouverte à tous pour qu'il puisse d'abord se créer un
      // compte : n'importe quel visiteur pouvait alors s'en fabriquer un.
      allow create: if false;

      // Les deux cas sont definis plus haut, en fonctions.
      allow update: if majParGestionnaire() || majDeSesAlertes(uid);

      allow delete: if isOwner() && cibleModifiable();
    }

    // Invitations en attente, une par jeton.
    // Le lien vaut accès à lui seul : qui l'a en main obtient un accès, avec
    // l'adresse de son choix. D'où l'expiration, et la suppression du jeton
    // dès qu'il a servi.
    match /invites/{token} {
      allow list:   if isOwner();
      // Lecture et suppression étaient ouvertes à tout compte connecté, pour
      // que l'invité lise son rôle puis consomme son jeton. Ce détour n'a plus
      // lieu d'être : le Worker fait les deux avec la clé de service. La
      // condition ne protégeait d'ailleurs rien, un compte s'obtenant en
      // quelques secondes — seul le secret du jeton comptait vraiment.
      allow get:    if isOwner();
      // Inviter un superadmin est réservé aux superadmins : sans ce contrôle,
      // un administrateur se fabrique une invitation superadmin, l'accepte
      // avec une seconde adresse, et le verrou du dessus ne vaut plus rien.
      allow create: if isOwner() && inviteNonSuperadmin();
      // Annulation d'une invitation depuis l'onglet Équipe.
      allow delete: if isOwner();
    }
  }
}
