rules_version = '2';

// À copier-coller dans Firebase Console > Firestore Database > Règles > Publier
// Lecture publique (le site doit pouvoir afficher le contenu à tout le monde).
// Écriture réservée aux comptes connectés (créés manuellement dans Authentication,
// pas de page d'inscription publique = personne d'autre ne peut créer de compte).

service cloud.firestore {
  match /databases/{database}/documents {

    match /settings/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /blocks/{blockId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
