rules_version = '2';

// À copier-coller dans Firebase Console > Storage > Règles > Publier
// Lecture publique (les photos doivent s'afficher sur le site pour tout le monde).
// Écriture réservée aux comptes connectés.

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 8 * 1024 * 1024; // 8 Mo max par fichier
    }
  }
}
